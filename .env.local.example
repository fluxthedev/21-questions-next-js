# Copy this file to .env.local and fill in your own MongoDB connection string.
# Never commit .env.local — it's already in .gitignore.

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Name of the database to use. The seed script creates it if it doesn't exist.
MONGODB_DB=twenty_one_questions